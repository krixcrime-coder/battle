<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Rush47" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_primary</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
    </style>

    <style name="Theme.Rush47.Splash" parent="Theme.Rush47">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="RoundedInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_rounded_input</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColorHint">#888888</item>
        <item name="android:elevation">3dp</item>
    </style>
</resources>
